# ── runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── database ───────────────────────────────────────────────
# DATABASE_URL: Supabase TRANSACTION pooler, port 6543.
#   Used by the API at runtime. Required — the direct db.<ref>.supabase.co
#   host is IPv6-only and will fail on Vercel with ENETUNREACH.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# DIRECT_DATABASE_URL: Supabase SESSION pooler, port 5432.
#   Used only for migrations and seeding, which need prepared statements.
DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── supabase ───────────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>

# ── mock auth (no real auth in this build) ─────────────────
MOCK_USER_ID=00000000-0000-0000-0000-000000000001

# ── middleware ─────────────────────────────────────────────
CORS_ORIGINS=*
RATE_LIMIT_MAX=100
RATE_LIMIT_WRITE_MAX=20
